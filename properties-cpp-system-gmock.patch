diff -up properties-cpp/cmake/FindGMock.cmake.1~ properties-cpp/cmake/FindGMock.cmake
--- properties-cpp/cmake/FindGMock.cmake.1~	1970-01-01 01:00:00.000000000 +0100
+++ properties-cpp/cmake/FindGMock.cmake	2026-08-03 00:00:00.000000000 +0000
@@ -0,0 +1,19 @@
+include(FindPackageHandleStandardArgs)
+
+# Prefer system-installed gtest/gmock libraries over building from /usr/src
+find_path(GTEST_INCLUDE_DIR gtest/gtest.h)
+find_path(GMOCK_INCLUDE_DIR gmock/gmock.h)
+
+set(GMOCK_LIBRARY -lgmock)
+set(GMOCK_MAIN_LIBRARY -lgmock_main)
+set(GMOCK_BOTH_LIBRARIES ${GMOCK_LIBRARY} ${GMOCK_MAIN_LIBRARY})
+set(GTEST_LIBRARY -lgtest)
+set(GTEST_MAIN_LIBRARY -lgtest_main)
+set(GTEST_BOTH_LIBRARIES ${GTEST_LIBRARY} ${GTEST_MAIN_LIBRARY})
+set(GTEST_ALL_LIBRARIES ${GTEST_BOTH_LIBRARIES} ${GMOCK_BOTH_LIBRARIES})
+set(GTEST_INCLUDE_DIRS ${GTEST_INCLUDE_DIR})
+set(GMOCK_INCLUDE_DIRS ${GMOCK_INCLUDE_DIR})
+
+find_package_handle_standard_args(GMock DEFAULT_MSG
+                                    GMOCK_INCLUDE_DIR
+                                    GTEST_INCLUDE_DIR)
